# Generated by Cargo
# will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# IntelliJ
.idea/
**/*.iml


**/__pycache__
**/*.pyc
.venv/
# The extension module an editable install of the Python bindings builds into their source
crates/redb-python/python/redb/*.so
crates/redb-python/python/redb/*.pyd
# Not checked in, like Cargo.lock
uv.lock

# Profiling
perf.data*
flamegraph.svg

# benchmark and test temporary files
/.tmp*
.vscode/settings.json

**/*.redb

# Hypothesis example database
.hypothesis/
